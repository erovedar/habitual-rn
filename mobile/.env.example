# Base URL of the server workspace's API.
# - iOS Simulator / web: http://localhost:3000
# - Android Emulator: http://10.0.2.2:3000 (localhost inside the emulator refers to the emulator itself)
# - Physical device (Expo Go / dev build): http://<your-machine's-LAN-IP>:3000
EXPO_PUBLIC_API_URL=http://localhost:3000
